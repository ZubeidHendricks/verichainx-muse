# Meta Model API (https://dev.meta.ai/api-keys/). Leave empty to run the offline mock engine.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Optional per-task overrides of MUSE_MODEL, e.g. VERIFY_MODEL=muse-wonder-1.0 to A/B test verification.
VERIFY_MODEL=
SELLER_MODEL=
SAM_MODEL=sam-3.1
REASONING_EFFORT=medium

# Hedera operator for anchoring. Leave empty to issue records without anchoring.
HEDERA_NETWORK=testnet
OPERATOR_ID=
OPERATOR_KEY=
# Reuse an existing topic; if empty, one is created on first anchor (check the logs for its id).
HEDERA_TOPIC_ID=

DATABASE_PATH=verichainx.db
# Used in passport links and to decide MCP host checking (localhost keeps DNS-rebinding protection on).
PUBLIC_BASE_URL=http://localhost:8000
USD_ZAR_RATE=18.0
